# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file

# Server
PORT=5000
NODE_ENV=development

# Database (fill in after DB Manager sets up schema)
DB_URI=your_database_connection_string_here

# Auth (fill in after Auth Engineer sets up JWT)
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=1d

# Biometric API (fill in after confirming with team)
BIOMETRIC_API_URL=https://your-biometric-api.com
BIOMETRIC_API_KEY=your_api_key_here

# CORS — set to your frontend URL in production
CORS_ORIGIN=http://localhost:5173
